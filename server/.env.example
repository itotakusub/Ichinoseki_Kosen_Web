# server/.env の見本。**実物は配備対象外**(deploy-to-host.ps1 は .env を送らない)。
#
# 値を入れるのはホスト側だけ。**このファイルに実際の秘密を書かないこと。**
#
# ---------------------------------------------------------------------------
# 公開 URL(1.0.1 で追加。VPS + 独自ドメインへ移すときに触るのはここ)
# ---------------------------------------------------------------------------
# 何も書かなければ、いまの校内 LAN 構成(192.168.3.29 / 9443)のまま動く。
#
# ---------------------------------------------------------------------------
# **VPS(compose.vps.yaml)で必須なのは KM_DOMAIN だけ**(2026-09-14 から)
# ---------------------------------------------------------------------------
#   KM_DOMAIN=kosenmap.example.jp
#
# これだけで、下の URL 系・証明書のパス・メールの差出人は compose.vps.yaml が導く
# (一覧はあのファイルの先頭)。**空の行は「書いていない」と同じ**なので、下の空欄はそのままでよい。
# 個別に変えたいものだけ値を入れる。KM_DOMAIN が無いと compose が起動前に止まる。
#
# ドメインを変えるときは、ここを手で書き換えずに scripts/host-domain.sh apply <新ドメイン> を使う
# (.env の控え・証明書の確認・KM_API_RESOURCE の保存・Logto 側の URL の書き換えの案内までやる)。
#
# 以前はこう全部書く決まりだった(いまも書けば効く):
#   KM_APP_URL=https://kosenmap.example.jp
#   KM_APP_PORT=443
#   KM_CERT=/etc/letsencrypt/live/kosenmap.example.jp/fullchain.pem
#   KM_CERT_KEY=/etc/letsencrypt/live/kosenmap.example.jp/privkey.pem
#
# APP_URL は **PHP 側の正本**でもある(lib/site.php が画面のリンクと死活監視に使う)。
# 書くなら KM_APP_URL と同じ値にすること。
# ---------------------------------------------------------------------------
# **ローカル環境(LAN の検証機)にするときだけ**(2026-09-17。本番では書かない)
# ---------------------------------------------------------------------------
# 手で書かずに、検証機で scripts/host-local.sh init --domain <名前> を実行する。次の 3 行と、
# 自作 CA の証明書(certs/)と、管理系ポートの許可(nginx/km/allow-admin-home.local.conf)をまとめて作る:
#
#   KM_ENV=local
#   KM_DOMAIN=km.test
#   COMPOSE_FILE=compose.yaml:compose.vps.yaml:compose.local.yaml
#
# compose.local.yaml が、Let's Encrypt → 自作 CA、mailserver → Mailpit、コンテナの中の名前解決を差し替える。
# **本番の .env に KM_ENV=local を書くと、deploy-to-host.ps1 が止まる。** 手順は docs/13-local-env.ipynb。
KM_ENV=
KM_DOMAIN=
KM_APP_URL=
KM_APP_PORT=
KM_CERT=
KM_CERT_KEY=
APP_URL=

# ---------------------------------------------------------------------------
# 管理画面を別オリジンに置く(2026-09-15。**空なら公開側と同じ = 今までどおり**)
# ---------------------------------------------------------------------------
# 公開ページ(地図・問い合わせ)のどこかにスクリプトを差し込まれても、管理画面に届かないようにする。
# **VPS では KM_ADMIN_DOMAIN だけ書けば**、管理画面・phpMyAdmin・Logto Console・Mailpit の URL を
# compose.vps.yaml が導く(https://<KM_ADMIN_DOMAIN>、:8281、:3002、:8025)。
#
#   KM_ADMIN_DOMAIN=admin.kosenmap.example.jp
#
# **書く前にそろえる 3 つ**(手順は docs/12-hardening-2026-09-15.ipynb の §5):
#   1. DNS … 管理用の名前の A レコードを、このホストに向ける
#   2. 証明書 … scripts/host-cert.sh issue --domain <KM_DOMAIN> --email <連絡先> --also <KM_ADMIN_DOMAIN>
#   3. Logto Console … Web アプリの「リダイレクト URI」に https://<KM_ADMIN_DOMAIN>/callback.php、
#                      「サインアウト後のリダイレクト URI」に https://<KM_ADMIN_DOMAIN>/ を**足す**(公開側の分は消さない)
# どれかが欠けると管理画面に入れなくなる。戻すときは KM_ADMIN_DOMAIN を空にして `docker compose up -d`。
#
# 個別に書く場合(校内 LAN の compose.yaml 単体など)は 3 つとも同じホストを指すこと:
#   KM_ADMIN_URL(nginx)と ADMIN_URL(PHP)は同じ値
KM_ADMIN_DOMAIN=
KM_ADMIN_URL=
ADMIN_URL=

# **サービスが自分の公開 URL として名乗る値。**
# ここも空なら現行の校内 LAN 構成のまま。**ドメインへ移すときは必ず埋める。**
#
# 埋め忘れると、公開ページは動くのに **管理画面だけ 503**(認証の設定が未完了)になる。
# PHP が旧ホストの Logto を見に行き続けるため —— 移行がほぼ終わったように
# 見えてから気付くので、たちが悪い。
#
#   LOGTO_ENDPOINT=https://kosenmap.example.jp:3001
#   LOGTO_ADMIN_ENDPOINT=https://kosenmap.example.jp:3002
#   PMA_ABSOLUTE_URI=https://kosenmap.example.jp:8281/
LOGTO_ENDPOINT=
LOGTO_ADMIN_ENDPOINT=
PMA_ABSOLUTE_URI=

# ---------------------------------------------------------------------------
# **VPS では必ず設定する。** 素の `docker compose` が読むファイルを指定する
# ---------------------------------------------------------------------------
# 指定しないと `docker compose up -d` は compose.yaml **だけ**を読む。そこには
# 校内 LAN 用の `192.168.3.29:8080:80` などが書いてあり、VPS にその IP は無いので
#
#     failed to bind host port 192.168.3.29:8080/tcp: cannot assign requested address
#
# で失敗する(2026-08-28 に 3306 で実際に踏んだ。**そのとき nginx も落ちてサイトが停止した**)。
# 証明書も Let's Encrypt ではなく mkcert の置き場を探し、certbot も mailserver も起動しない。
# (3306 の publish は 2026-09-15 に compose.yaml から外した。MariaDB は internal の網にしか居ない)
#
# ここを設定しておけば、`-f` を書き忘れても正しい構成で動く。
#
#   COMPOSE_FILE=compose.yaml:compose.vps.yaml
#
# **校内 LAN の Windows ホストでは設定しないこと**(あちらは compose.yaml 単体が正しい)。
COMPOSE_FILE=

# ---------------------------------------------------------------------------
# データベース(MariaDB)
# ---------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

# phpMyAdmin に root でログインするのを**一時的に**許す(2026-09-14 から既定は禁止)。
# 1 のときだけ許す。済んだら空に戻して `docker compose up -d phpmyadmin`。
# 仕組みは docker/phpmyadmin/config.user.inc.php にある。
KM_PMA_ALLOW_ROOT=

# ---------------------------------------------------------------------------
# Logto
# ---------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Logto が繋ぐ **SUPERUSER でない**利用者(2026-09-15)。**空なら今までどおり POSTGRES_USER で繋ぐ。**
# 作り方は docs/12-hardening-2026-09-15.ipynb の §3(scripts/logto-db-role.sql が持ち物を移し、
# セルがパスワードを英数字で作ってここへ書く)。POSTGRES_USER はバックアップと管理の作業だけに使う。
# **控えから戻したら、同じセルをもう一度流す**(戻すと表の持ち主が POSTGRES_USER に戻るため)。
# まっさらな DB に Logto を初めて立てるとき(db seed)は CREATEROLE が要るので、そのときだけは空にしておく。
LOGTO_DB_USER=
LOGTO_DB_PASSWORD=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# 管理画面のユーザー一覧が使う machine-to-machine アプリ。
# Logto Console で **Logto Management API のロールを割り当てておくこと**
# これは Users の書き込み権限を持つ。
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# アカウントが削除されたことを受け取る webhook の署名鍵。
#
# Logto Console → Webhooks で `https://<ホスト>/api/logto-webhook.php` を登録し、
# イベントに **User.Deleted** を選ぶ。そこに表示される "Signing key" をここへ。
#
# **空のままなら、この口は何も受け付けない。**
# 「鍵が無いから素通し」にはしていない —— 設定し忘れがそのまま穴になるため。
# 逆に言うと、**鍵を入れるまでアカウント削除の後片付けは動かない。**
#
# 埋める前に Logto 側の「アカウントを削除」を開けないこと。
# 先に開けると、消えた人の行が**誰のものか分からないまま**残る。
#
# **2026-09-14 まで、ここに書いても web コンテナに渡っていなかった**(compose が environment に
# 名前を書いていなかったため。server-ops 1)。署名の検証が毎回失敗し、後片付けは一度も動いていない。
LOGTO_WEBHOOK_SIGNING_KEY=

# Logto の API リソース識別子(= 管理画面と Android が受け取るアクセストークンの audience)。
#
# Logto Console の API リソースに登録してある文字列そのもので、URL の形をしているが**名前にすぎない**(そこへ通信はしない)。
# **Logto の登録・この値・Android の kosenmap.apiResource の 3 つが一致していないと**、トークンの audience が合わず
# 管理画面にも Android の管理版にも入れなくなる。
#
# 空なら VPS は https://<KM_DOMAIN>/api、校内 LAN は https://192.168.3.29:9443/api を使う。
# ドメインを移すとき、**据え置くなら** scripts/host-domain.sh apply が旧ドメインの値をここへ書く。
# **一緒に移すなら**(2026-09-17 に ito8795.com → ito4.jp で移した)、先に src/scripts/logto-api-resource.php で
# Logto に新しいリソースを作り、host-domain.sh apply --api-resource https://<新>/api で書く(docs/14)。
KM_API_RESOURCE=

# 教職員の権限(docs/15-staff-org.ipynb。2026-09-18)。
#
# Logto Console で作った**組織の ID**(例 0kpbyqtgrkcc)。**空ならこの機能は無効**(付けない・判定しない)。
# 秘密ではないが、環境ごと(本番・検証機)に違う。ロール名と権限名は既定で足りる。
# **学生と教職員でメールのドメインが同じ**なので、Logto の JIT(ドメインでの自動付与)は使わない。
# 付けるのは管理画面での承認のときだけ(lib/staff-org.php)。
KM_LOGTO_ORG_ID=
#KM_LOGTO_STAFF_ORG_ROLE=Kosen_Member
#KM_LOGTO_STAFF_SCOPE=staff:normal:access

# 参照しかしない口(api/app-stats.php の人数集計)が使う m2m アプリ。
#
# ---------------------------------------------------------------------------
# ⚠ **いまの Logto では、ここに意味のある値を入れられない。空のままにすること。**
# ---------------------------------------------------------------------------
#
# 以前ここには「Management API のロールで read:user と read:organization だけを
# 与えること」と書いてあったが、**それはできない。**
# Logto の Management API リソース(`https://default.logto.app/api`)が持つ
# スコープは **`all` の1つだけ**で、読み取りだけを切り出す方法が無い。
#
# 独自の API リソースを作って read:user 等のスコープを置くことはできるが、
# **それは Management API とは別のリソース**なので、その資格情報で
# Management API を叩いても **403 になる**。
#
# 2026-08-28、本番でこれを踏んだ:
# 読み取り専用のつもりの資格情報が 403 になり、停止判定(km_logto_user_is_suspended)
# が例外を投げ、guard がフェイルクローズして **管理画面が全面停止した**。
# しかも Logto Console も同じゲートの内側にあるため、**直しに行けなくなる。**
#
# 空にしておけば上の LOGTO_M2M_* に落ちる。**片方だけ書くと例外で止まる。**
#
# 権限を本当に分けたいなら、Logto のロールではなく
# **公開の口が Management API を使わない形にする**必要がある(人数を別途集計して
# 保存し、公開の口はそれを読むだけにする)。
LOGTO_M2M_READONLY_APP_ID=
LOGTO_M2M_READONLY_APP_SECRET=

# ---------------------------------------------------------------------------
# Soketi(チャットと死活監視のリアルタイム配信)
# ---------------------------------------------------------------------------
SOKETI_APP_ID=
SOKETI_APP_KEY=
SOKETI_APP_SECRET=

# ---------------------------------------------------------------------------
# reCAPTCHA(公開の問い合わせフォーム)
# ---------------------------------------------------------------------------
# Enterprise 版: SITE_KEY + PROJECT_ID + API_KEY
# クラシック版: SITE_KEY + SECRET_KEY
# どちらが使われるかは lib/recaptcha.php が置かれた値で判断する。
# 確認: docker compose exec -T web php scripts/check.php recaptcha
#
# ---------------------------------------------------------------------------
# ⚠ API キーの「アプリケーションの制限」は **IP アドレス** にすること
# ---------------------------------------------------------------------------
# 検証を叩くのは**サーバー側の curl** で、Referer ヘッダーを送らない。
# そのため「HTTP リファラー」で制限すると **必ず 403 になり、フォームが送れなくなる**
# (2026-08-29 に本番で発生。利用者には「認証の確認に失敗しました」としか出ない)。
#
#   アプリケーションの制限 … IP アドレス。VPS の送信元 IP を登録する
#   API の制限           … reCAPTCHA Enterprise API だけに絞る(こちらは正しい)
#
# なお Enterprise を選んだのは「サイトが IP アドレスで動いていてドメイン欄に
# 登録できない」という理由だった。**いまはドメインがあるので前提が消えている。**
# クラシックへ戻すなら SECRET_KEY を入れて PROJECT_ID と API_KEY を空にするだけでよく、
# Google Cloud の API キー管理そのものが要らなくなる(コードは変えない)。
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# メール送信
# ---------------------------------------------------------------------------
# **何も書かなければ Mailpit へ落ちる**(開発用の受け皿。外部へは配送しない)。
# 検証環境はこのまま空でよい。
#
# **VPS(compose.vps.yaml)では 2026-09-14 から、空なら mailserver:587 と noreply@<KM_DOMAIN> になる。**
# Mailpit は本番では起動しない(profile "mailpit")。下の例は、既定と違う値にしたいときだけ書く。
#
# 本番で外部へ送るときだけ埋める。**コードは変えなくてよい** ——
# lib/mailer.php が「MAIL_USERNAME が空なら認証しない / MAIL_ENCRYPTION が空なら平文」
# と解釈するので、下を足した時点で認証つき送信に切り替わる。
#
# 自前の送信サーバー(compose.vps.yaml の mailserver)を使う例:
#   MAIL_HOST=mailserver
#   MAIL_PORT=587
#   MAIL_FROM=noreply@ito4.jp
#   MAIL_FROM_NAME=高専マップ
#   MAIL_ADMIN_TO=<問い合わせ通知の宛先>
#
# 送信サービスへ移す場合は、上の MAIL_HOST/PORT を先方の値にして、
# **MAIL_USERNAME / MAIL_PASSWORD / MAIL_ENCRYPTION=tls を足すだけ。**
#
# **MAIL_FROM のドメインは、SPF/DKIM を設定したものと一致させること。**
# 既定の example.test は存在しないドメインなので、本番では必ず変える。
MAIL_HOST=
MAIL_PORT=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_ADMIN_TO=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# ---------------------------------------------------------------------------
# CSP(1.0.1)
# ---------------------------------------------------------------------------
# 1 にすると Content-Security-Policy-Report-Only で送る。**壊さずに様子を見たいとき用**。
# 空(既定)なら強制。
KM_CSP_REPORT_ONLY=
