# 案内チャットの LLM(自宅 PC)の設定の見本。**これに値を入れない**(このファイルは git と公開の控えに入る)。
# guide-llm.env に写して埋める(guide-llm.env は git に入れない)。読むのは start-guide-llm.ps1。
# 2026-10-25: 頼む先を Unsloth から Bionic に替えた(UNSLOTH_API_URL / UNSLOTH_API_KEY は LLM_API_URL / LLM_API_KEY になった)。

# 模型。使ってよいのは 4 つだけ: Gemma4 E4B / Gemma 12B QAT / Qwen3.5-9B / GPT-OSS-20B
# GUIDE_LLM_MODEL には Bionic の模型の識別名を入れる(Bionic への頼みにもこの名前を付ける。/v1/models にあるかも確かめる)。
GUIDE_LLM_MODEL=
# その模型が 4 つのどれか: gemma4-e4b / gemma-12b-qat / qwen3.5-9b / gpt-oss-20b
# 識別名(例 3885219b…)から分からないので言い切る。識別名に「qwen3.5-9b」などが入っていれば空でよい(入っていて食い違えば起こさない)
# custom にすると 4 つの決まりを外し、GUIDE_LLM_MODEL の識別子を替えるだけで別の模型を読む
GUIDE_LLM_FAMILY=
# 考えを止める指定(none / low / medium / high / off。空なら模型ごとの既定: Qwen と custom は none、GPT-OSS は low)
GUIDE_LLM_REASONING_EFFORT=
# 模型を読むときの長さ(トークン)。空なら Bionic の既定。起動のたびに、ロード済みならアンロードしてから読み直す
GUIDE_LLM_CONTEXT_LENGTH=

# VPS の PHP が付けてくる鍵。**秘密**。32 字以上のでたらめな文字列(Website の .env の KM_GUIDE_LLM_KEY と同じ値)。
# 作り方(PowerShell): -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
KM_GUIDE_LLM_KEY=

# 門番(server.py)が待ち受ける番号(127.0.0.1 だけ)。ngrok はここへつなぐ
GUIDE_LLM_PORT=8888

# ngrok の固定のドメイン(ngrok のダッシュボードで 1 つ取れる。例: kosenmap-guide.ngrok-free.dev)。https:// は付けても付けなくてもよい。
# 固定にしないと、起動のたびに URL が変わり、Website の .env を書き換えて配備し直すことになる
NGROK_DOMAIN=

# 動かしている Bionic の API(OpenAI と同じ形の /v1/chat/completions がある所)。例: http://127.0.0.1:1235
# **この PC の中だけ**を指すこと(外へは ngrok と門番だけが出す)
LLM_API_URL=
# Bionic の API に鍵を付けているときだけ
LLM_API_KEY=
