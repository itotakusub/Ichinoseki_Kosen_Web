# 案内チャットの LLM(自宅 PC)の設定の見本。**これに値を入れない**(このファイルは git と公開の控えに入る)。
# guide-llm.env に写して埋める(guide-llm.env は git に入れない)。読むのは start-guide-llm.ps1。
# 2026-10-29: 頼み先を 2 つ持てるようにした(Unsloth と Bionic)。管理画面「案内チャット」の「模型」で選べる。

# ---- 頼み先(この PC の中だけ。片方だけでもよい) ----
# Unsloth の API(例: http://127.0.0.1:8888 。末尾の /v1 は付けても付けなくてもよい)
UNSLOTH_API_URL=
# Unsloth の API キー(Unsloth の画面で作る。**秘密**)
UNSLOTH_API_KEY=
# Bionic の API(例: http://127.0.0.1:1235)。古い名前 LLM_API_URL / LLM_API_KEY でも読む
BIONIC_API_URL=
# Bionic の API に鍵を付けているときだけ
BIONIC_API_KEY=

# ---- 既定 ----
# 既定の頼み先(unsloth / bionic)。管理画面で模型を選んでいなければ、ここへ頼む
GUIDE_LLM_BACKEND=
# 既定の模型の識別子(空なら、既定の頼み先でいま読んでいる模型)。起動のたびに、読み込み済みでもアンロードしてから読み込む
GUIDE_LLM_MODEL=
# 考えを止める指定(none / low / medium / high / off。空なら none。止められない模型では low に置き換える)
GUIDE_LLM_REASONING_EFFORT=
# 模型を読むときの長さ(トークン)。空なら頼み先の既定
GUIDE_LLM_CONTEXT_LENGTH=

# VPS の PHP が付けてくる鍵。**秘密**。32 字以上のでたらめな文字列(Website の .env の KM_GUIDE_LLM_KEY と同じ値)。
# 作り方(PowerShell): -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
KM_GUIDE_LLM_KEY=

# 門番(server.py)が待ち受ける番号(127.0.0.1 だけ)。トンネル(cloudflared)はここへつなぐ。**頼み先の番号(Unsloth 8888 など)と別にする**
GUIDE_LLM_PORT=8192

# ---- 外へ出す(Cloudflare Tunnel。段 12・2026-11-12。作り方は start-guide-llm.ps1 の冒頭と docs/17-cloudflare.ipynb) ----
# トンネルの UUID(cloudflared tunnel create kosenmap-guide で出る 36 字。鍵のファイル %USERPROFILE%\.cloudflared\<UUID>.json は**秘密**。ここには場所も中身も書かない)
CLOUDFLARE_TUNNEL=
# 外に出す名前(cloudflared tunnel route dns kosenmap-guide <名前> で向けたもの。例: llm.ito4.jp)。Website の .env の KM_GUIDE_LLM_URL は https://<この名前>
CLOUDFLARE_HOSTNAME=
# つなぎ方(auto / http2 / quic。空なら auto)。セキュリティのソフトが間に入ってつながらないときは http2
CLOUDFLARE_PROTOCOL=
