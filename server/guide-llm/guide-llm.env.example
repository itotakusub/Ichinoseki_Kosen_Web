# 案内チャットの LLM(自宅 PC)の設定。これを guide-llm.env に写して埋める(guide-llm.env は git に入れない)。
# 読むのは start-guide-llm.ps1(WSL で server.py に渡す)。

# 模型(Hugging Face の unsloth の名前)。使ってよいのは 4 つだけ:
#   Gemma4 E4B / Gemma 12B QAT / Qwen3.5-9B / GPT-OSS-20B
# 正しい名前は https://huggingface.co/unsloth で確かめて入れる(server.py が 4 つのどれかか確かめる)。
GUIDE_LLM_MODEL=

# VPS の PHP が付けてくる鍵。**秘密**。32 字以上のでたらめな文字列(Website の .env の KM_GUIDE_LLM_KEY と同じ値)。
# 作り方(PowerShell): -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
KM_GUIDE_LLM_KEY=

# 待ち受ける番号(127.0.0.1 だけ)
GUIDE_LLM_PORT=8000
# 読む長さ(トークン)。案内は短いので 4096 で足りる
GUIDE_LLM_MAX_SEQ=4096

# ngrok の固定のドメイン(ngrok のダッシュボードで 1 つ取れる。例: kosenmap-guide.ngrok-free.app)。
# 固定にしないと、起動のたびに URL が変わり、Website の .env を書き換えて配備し直すことになる
NGROK_DOMAIN=

# WSL の Ubuntu の中で、このフォルダを指すパス(例: /mnt/c/Users/<名前>/Documents/Website/server/guide-llm)
# と、Python の仮想環境(setup の手順で作る)
WSL_DIR=
WSL_DISTRO=Ubuntu
