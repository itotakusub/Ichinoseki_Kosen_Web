# Soketi
#
# **ここにもゲートを掛けない。** ブラウザが直接 WebSocket を張る先で、購読の可否は
# 9443 側の chat-auth.php(CSRF 検証 + チャンネル許可リスト)が署名で決めている。
server {
    listen 6001 ssl;
    listen [::]:6001 ssl;
    server_name ${KM_DOMAIN};
    # 待ち時間と同時接続(2026-09-14。server-ops 3)。WebSocket は 1 本を長く張るので、1 つの送信元に 50 本まで。
    # keepalive_timeout は Upgrade したあとの接続には効かない(そちらは下の proxy_read_timeout)。
    keepalive_timeout 30s;
    limit_conn km_conn 50;

    # 管理画面以外のページから張られた接続を断る(2026-09-14。map $km_ws_origin_denied の注記を参照)。
    # **管理画面を別の名前(localhost など)で開くとチャットが「未接続」になる。** そのときは ${KM_APP_URL} で開く。
    if ($km_ws_origin_denied) {
        return 403;
    }

    # **配信の HTTP API(/apps/…)を外に出さない**(2026-09-15)。
    # ブラウザが使うのは WebSocket の /app/<key> だけで、/apps/<id>/events などは PHP が
    # コンテナの中から soketi:6001 へ直に叩く(lib/soketi.php)。署名は Soketi が見るが、
    # **時刻の古い署名も通る**(2026-09-15 に使い捨てで実測)—— 一度漏れた署名付きの要求を
    # 外から何度でも投げ直せる。使わない口は入口で閉じる。
    location ^~ /apps/ {
        return 404;
    }

    location / {
        proxy_pass http://km_soketi;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port 6001;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }
}

# Mailpit(開発用のメール受け皿)
#
# 受信したメールは**誰の宛先でも読めてしまう**ので、インターネットに出す前提では
# 必ずゲートの内側に置く。SMTP(1025)はコンテナ内部だけで、外へは出していない。
server {
    listen 8025 ssl;
    listen [::]:8025 ssl;
    server_name ${KM_DOMAIN};
    # 待ち時間と同時接続(2026-09-14。管理系は 50 本)
    keepalive_timeout 30s;
    limit_conn km_conn 50;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # 他のサイトの枠に入れさせない(security-review-2026-09-10 の 16)。
    # **frame-ancestors だけを足す** —— 中身の CSP は相手(phpMyAdmin / Mailpit)が決めるので触らない。
    # CSP は複数あると全部が効く(厳しい側になる)ので、相手の設定を緩めることはない。
    # 3001(Logto)には付けない: Logto が自分で frame-ancestors(Console の 3002 を含む)を送っており、
    # こちらで 'self' だけに絞ると Console のサインイン画面の下見が壊れる(2026-09-14 に実測)
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    include /etc/nginx/km/hsts-*.conf;

    include /etc/nginx/km/allow-*.conf;

    location / {
        auth_request /__km_gate;
        error_page 401 = @km_login;
        # 1枚目(allow-*.conf)で断った相手には 403 のページも返さず、接続を切る(@km_hide は gate-location.conf)
        error_page 403 = @km_hide;

        # **Mailpit が居なくても nginx が起動できるようにする**(2026-09-14。本番では Mailpit を起動しない)。
        # `proxy_pass http://mailpit:8025;` と直に書くと、nginx は起動時に名前を引き、
        # 引けなければ "host not found in upstream" で**起動そのものに失敗する** —— 443 まで巻き添えで止まる。
        # 変数に入れると、名前はリクエストの時に Docker の内蔵 DNS(127.0.0.11)で引くようになる。
        # 居なければ 502 を返すだけ。変数の proxy_pass は URI を書き換えないので、渡るパスは今までと同じ。
        # (resolver は http に1本だけ書いてある。他の転送先は upstream + resolve —— 冒頭の注記)
        set $km_mailpit_upstream http://mailpit:8025;
        proxy_pass $km_mailpit_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port 8025;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Mailpit の画面は受信を WebSocket でライブ更新するので、Soketi と同じ扱いが要る
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_hide_header X-Powered-By;
        # proxy_read_timeout は http の既定 60 秒のまま(2026-09-14 に 300s を外した)。
        # 長く待つ理由のある口ではない。画面のライブ更新が切れても、Mailpit の画面が張り直す
    }

    include /etc/nginx/km/gate-location.conf;
}
